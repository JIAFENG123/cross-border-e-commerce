# Default Provider: "groq" (ultra-fast) or "nvidia" (ultra-large 550b)
DEFAULT_PROVIDER=groq

# Groq API Settings (Ultra-fast LPU inference ~500 tok/s)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# NVIDIA NIM API Settings (550B Flagship)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-bolt-e4b

# Agent Settings
MAX_RESEARCH_ITERATIONS=1
DEFAULT_TARGET_MARKET=US
TIMEOUT_SECONDS=60.0
