# Streamlit Cloud Secrets Configuration Template
# 在 Streamlit Community Cloud 的 App Settings -> Secrets 中复制粘贴以下内容并填入真实 Key

DEFAULT_PROVIDER = "groq"

# Groq API 配置 (免费推荐: https://console.groq.com)
GROQ_API_KEY = "gsk_your_groq_api_key_here"
GROQ_BASE_URL = "https://api.groq.com/openai/v1"
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_MODEL_REASONING = "openai/gpt-oss-120b"
GROQ_MODEL_FAST = "openai/gpt-oss-20b"

# NVIDIA NIM 配置 (备用: https://build.nvidia.com)
NVIDIA_API_KEY = ""
NVIDIA_BASE_URL = "https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL = "nvidia/nemotron-3-ultra-550b-a55b"
